{
  "name": "quietcast",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Quiet Cast — HTML-first Astro relaunch on Cloudflare",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=.certs/ca.pem astro dev",
    "build": "NODE_EXTRA_CA_CERTS=.certs/ca.pem astro build",
    "preview": "wrangler pages dev ./dist",
    "check": "NODE_EXTRA_CA_CERTS=.certs/ca.pem astro check",
    "typecheck": "NODE_EXTRA_CA_CERTS=.certs/ca.pem astro check",
    "astro": "NODE_EXTRA_CA_CERTS=.certs/ca.pem astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/preact": "^5.1.0",
    "@sanity/client": "^7.0.0",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.45.0",
    "astro": "^6.0.0",
    "preact": "^10.24.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
