# Quiet Cast — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# Public (PUBLIC_*) values are inlined into the browser bundle — keep secrets out of them.

# --- Supabase (auth + private user data) ---
# Project Settings → API. The "publishable" key is the browser-safe one.
PUBLIC_SUPABASE_URL="https://zzftxvxgnkuowipeylen.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
# "secret" key — server-only, never exposed to the browser. Needed Phase 5+.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
# The curator's email — /admin/moderation is gated on it (one-owner site).
ADMIN_EMAIL="owner@quietcast.art"

# --- Sanity (public editorial CMS) ---
PUBLIC_SANITY_PROJECT_ID="vcfngr79"
PUBLIC_SANITY_DATASET="production"
# Editor token — server-only, for writes/migrations. Reads use the public dataset.
SANITY_API_TOKEN="skxxxxxxxxxxxxxxxxxxxx"

# --- Cloudflare R2 (audio: zero egress via custom domain) ---
# Reads go through the CDN URL below. NEVER use the r2.dev URL in prod.
PUBLIC_CDN_URL="https://cdn.quietcast.art"
# S3-API creds — server-only. Needed for presigned uploads (Phase 6) and the
# bulk audio upload (Phase 3). Generate under R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="quietcast-audio"
