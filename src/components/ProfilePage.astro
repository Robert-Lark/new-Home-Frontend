<style is:global>
  /* ---- rotation tiles (rendered by the RotationGrid island) ---- */
  .p-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .p-tile {
    position: relative;
  }
  .p-tile[data-dragging] {
    opacity: 0.6;
    outline: 1px dashed var(--steel);
    outline-offset: 2px;
  }
  .p-tile-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    padding-bottom: 12px;
  }
  .p-tile-link img,
  .p-tile-fallback {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    border: 1px solid var(--hairline);
    filter: grayscale(0.35) contrast(1.05);
    transition: filter var(--dur-fast) var(--ease-out);
  }
  .p-tile-link:hover img {
    filter: none;
  }
  .p-tile-fallback {
    display: grid;
    place-items: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    color: var(--ink-3);
    background: var(--surface-2);
  }
  .p-tile-n {
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .p-chip {
    align-self: flex-start;
    font-size: 8px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 2px 8px;
  }
  .p-tile-x,
  .p-tile-grab,
  .p-tile-mv {
    position: absolute;
    top: 6px;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--overart) 72%, transparent);
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .p-tile-x {
    right: 6px;
  }
  .p-tile-x:hover,
  .p-tile-grab:hover,
  .p-tile-mv:hover:not(:disabled) {
    border-color: var(--ember);
    color: var(--ember);
  }
  /* drag handle: touch-action none is what makes touch dragging possible —
     without it the browser claims the gesture for scrolling */
  .p-tile-grab {
    left: 6px;
    touch-action: none;
    cursor: grab;
  }
  .p-tile[data-dragging] .p-tile-grab {
    cursor: grabbing;
  }
  .p-tile-mvs {
    position: absolute;
    top: 6px;
    left: 36px;
    display: flex;
    gap: 4px;
  }
  .p-tile-mv {
    position: static;
    font-size: 10px;
  }
  .p-tile-mv:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .p-grid-msg {
    margin-top: 14px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-deep);
  }
  @media (max-width: 920px) {
    .p-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
