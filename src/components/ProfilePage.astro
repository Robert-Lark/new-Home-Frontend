---
import type { Track } from '../islands/PlayerDock';
import RotationGrid from '../islands/RotationGrid';
import { CONNECTION_KINDS, type CatalogEntry } from '../lib/connections';
import type { ActivityEvent, Connection, NewsItem } from '../lib/profile';
import type { WallActionResult, WallEntry } from '../lib/wall';
import { IMAGE_MAX_BYTES, ugcDate } from '../lib/ugc';

/**
 * Shared profile shell, old-web "top friends" anatomy in the site's own
 * vocabulary: profile card top-left, module boxes down the left column
 * (account, site news, slot "side"), and the main column with the bio blurb,
 * latest-activity list, and the rotation (connections) grid. Used by
 * /dashboard (editable) and /u/[id] (read-only). Grid edits are plain POST
 * forms handled by the hosting page (dashboard: catalog/free-form adds +
 * removes + reorders; /u/[id]: listener pins). The tiles render through the
 * RotationGrid island — static HTML on the public view, hydrated on
 * /dashboard for drag/keyboard reordering.
 */
interface Props {
  editable: boolean;
  profileId: string;
  displayName: string;
  avatarUrl: string | null;
  memberSince: string | null;
  /** Own view only — never passed on the public route. */
  email?: string | null;
  statusLine?: string | null;
  bio?: string | null;
  isPublic: boolean;
  song: Track | null;
  connections: Connection[];
  /** Catalog entries still addable (editable views only). */
  catalog?: CatalogEntry[];
  gridFull?: boolean;
  /** Failed free-form grid add to render inline (successes redirect, PRG). */
  gridResult?: { ok: boolean; message: string } | null;
  /** Listener-pin control for signed-in visitors (/u/[id] only). */
  pinState?: 'available' | 'pinned' | null;
  /** Failed pin attempt to render inline (successes redirect, PRG). */
  pinResult?: { ok: boolean; message: string } | null;
  activity: ActivityEvent[];
  news: NewsItem[];
  /** Comment wall, newest first. */
  wall: WallEntry[];
  /** Only public profiles accept notes (the insert RLS enforces it too). */
  wallOpen: boolean;
  /** Signed-in viewer id — drives the per-note delete/report affordances. */
  viewerId?: string | null;
  /** Failed wall action to render inline (successes redirect, PRG). */
  wallResult?: WallActionResult | null;
  showAdminLink?: boolean;
  /** Notice strip for owners previewing their public page. */
  previewBanner?: string;
}

const {
  editable,
  profileId,
  displayName,
  avatarUrl,
  memberSince,
  email = null,
  statusLine = null,
  bio = null,
  isPublic,
  song,
  connections,
  catalog = [],
  gridFull = false,
  gridResult = null,
  pinState = null,
  pinResult = null,
  activity,
  news,
  wall,
  wallOpen,
  viewerId = null,
  wallResult = null,
  showAdminLink = false,
  previewBanner,
} = Astro.props;

const initial = (displayName.trim()[0] ?? 'Q').toUpperCase();
/** Owner moderates their whole wall; authors take back their own notes. */
const canRemove = (note: WallEntry) => viewerId === profileId || viewerId === note.author_id;
/** Free-form entries can be anything except another listener — pins own that kind. */
const freeKinds = CONNECTION_KINDS.filter((k) => k !== 'listener');
/** Island props — just the fields the tiles render. */
const tiles = connections.map(({ id, name, kind, image_url, link_url }) => ({ id, name, kind, image_url, link_url }));
---

<section class="profile">
  {previewBanner && <p class="p-banner mono">{previewBanner}</p>}

  <div class="p-cols">
    <aside class="p-side">
      <div class="p-box p-card">
        {
          avatarUrl ? (
            <img class="p-avatar" src={avatarUrl} alt={`${displayName}'s profile picture`} />
          ) : (
            <div class="p-avatar p-avatar-fallback" aria-hidden="true">{initial}</div>
          )
        }
        <div class="p-card-body">
          <h1 class="p-name">{displayName}</h1>
          <span class="p-kind mono">listener{isPublic ? '' : ' · private'}</span>
          {statusLine && <p class="p-status">“{statusLine}”</p>}
          <ul class="p-meta mono">
            {memberSince && <li>Tuned in since {memberSince}</li>}
            {email && <li>{email}</li>}
          </ul>
          {
            song && song.src && (
              <button
                class="p-song"
                data-qc-play
                data-qc-id={song.id}
                data-qc-title={song.title}
                data-qc-artist={song.artist}
                data-qc-cover={song.cover}
                data-qc-src={song.src}
                data-qc-catalog={song.catalog}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                <span class="p-song-meta">
                  <i class="mono">Profile signal</i>
                  <b>{song.title}</b>
                </span>
              </button>
            )
          }
          {
            editable && (
              <div class="p-card-acts">
                <a href="/settings">Edit profile</a>
                <a href={`/u/${profileId}`}>View public page</a>
              </div>
            )
          }
          {
            pinState && (
              <div class="p-card-acts">
                {pinState === 'available' ? (
                  <form method="POST">
                    <input type="hidden" name="action" value="pin-listener" />
                    <button class="p-pin" type="submit">Pin to my rotation</button>
                  </form>
                ) : (
                  <span class="p-pin p-pin-done">In your rotation</span>
                )}
              </div>
            )
          }
          {pinResult && !pinResult.ok && <p class="p-card-msg mono">{pinResult.message}</p>}
        </div>
      </div>

      {
        editable && (
          <div class="p-box">
            <h2 class="p-box-h eyebrow">Account</h2>
            <div class="p-admin">
              <a href="/settings">Settings</a>
              {showAdminLink && <a href="/admin/moderation">Moderation</a>}
              <form method="POST" action="/auth/signout" data-astro-reload>
                <button type="submit">Sign out</button>
              </form>
            </div>
          </div>
        )
      }

      <slot name="side" />

      {
        news.length > 0 && (
          <div class="p-box">
            <h2 class="p-box-h eyebrow">Meanwhile on Quiet Cast</h2>
            <ul class="p-news">
              {news.map((n) => (
                <li>
                  <a href={n.href}>
                    <span class="p-news-k mono">{n.kind}</span>
                    <span class="p-news-t">{n.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>

    <div class="p-main">
      {
        (bio || editable) && (
          <section>
            <div class="section-label p-label">
              <span class="eyebrow">About</span>
              <span class="line" />
            </div>
            {bio ? (
              <p class="p-bio">{bio}</p>
            ) : (
              <p class="p-empty">
                Say who's broadcasting — <a href="/settings">add a bio</a>.
              </p>
            )}
          </section>
        )
      }

      <section>
        <div class="section-label p-label">
          <span class="eyebrow">Latest activity</span>
          <span class="line"></span>
          <span class="eyebrow">{activity.length}</span>
        </div>
        {
          activity.length === 0 ? (
            <p class="p-empty">
              All quiet so far{editable ? ' — play a broadcast, pin a connection, upload a mix.' : '.'}
            </p>
          ) : (
            <ul class="p-act">
              {activity.map((e) => (
                <li>
                  <span class="p-act-k mono">{e.kind}</span>
                  {e.href ? (
                    <a class="p-act-t" href={e.href}>{e.text}</a>
                  ) : (
                    <span class="p-act-t">{e.text}</span>
                  )}
                  {e.note && <span class="p-act-note mono">{e.note}</span>}
                  <span class="p-act-d mono">{ugcDate(e.at)}</span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section>
        <div class="section-label p-label">
          <span class="eyebrow">{displayName}’s rotation</span>
          <span class="line"></span>
          <span class="eyebrow">{connections.length}</span>
        </div>
        {
          connections.length === 0 ? (
            <p class="p-empty">
              {editable
                ? 'Nothing pinned yet. Your rotation is the artists, labels, and places that shape your listening.'
                : 'Nothing pinned yet.'}
            </p>
          ) : editable ? (
            <RotationGrid client:load tiles={tiles} editable={true} />
          ) : (
            <RotationGrid tiles={tiles} editable={false} />
          )
        }
        {gridResult && !gridResult.ok && <p class="p-grid-msg mono">{gridResult.message}</p>}
        {
          editable && !gridFull && (
            <div class="p-adds">
              {catalog.length > 0 && (
                <details class="p-add">
                  <summary class="mono">Pin to the rotation</summary>
                  <div class="p-add-box">
                    {/* Type-to-filter combobox over the rows below. Revealed only
                        when scripting is on — without JS the full list simply
                        scrolls. (<datalist> can't render image + chip rows.) */}
                    <search class="p-add-search">
                      <label class="visually-hidden" for="catalog-filter">Filter the catalog by name</label>
                      <input
                        class="ugc-input"
                        id="catalog-filter"
                        type="search"
                        placeholder="Type to filter…"
                        autocomplete="off"
                      />
                      <p class="p-add-count mono" aria-live="polite"></p>
                    </search>
                    <ul class="p-add-panel" role="list">
                      {catalog.map((entry) => (
                        <li data-name={entry.name.toLowerCase()}>
                          <form method="POST">
                            <input type="hidden" name="action" value="add-connection" />
                            <input type="hidden" name="slug" value={entry.slug} />
                            <button class="p-add-row" type="submit">
                              <img src={entry.image} alt="" loading="lazy" />
                              <span class="p-add-n">{entry.name}</span>
                              <span class="p-chip mono">{entry.kind}</span>
                              <span class="p-add-plus mono" aria-hidden="true">+</span>
                            </button>
                          </form>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              )}
              <details class="p-add" open={Boolean(gridResult)}>
                <summary class="mono">Add your own</summary>
                <form class="p-free ugc-form" method="POST" enctype="multipart/form-data">
                  <input type="hidden" name="action" value="add-free-connection" />
                  <div>
                    <label class="ugc-label" for="free-name">Name</label>
                    <input class="ugc-input" id="free-name" type="text" name="name" required maxlength="80" />
                  </div>
                  <div>
                    <label class="ugc-label" for="free-kind">Kind</label>
                    <select class="ugc-select" id="free-kind" name="kind">
                      {freeKinds.map((k) => <option value={k}>{k}</option>)}
                    </select>
                  </div>
                  <div>
                    <label class="ugc-label" for="free-link">Link — optional</label>
                    <input
                      class="ugc-input"
                      id="free-link"
                      type="url"
                      name="link"
                      maxlength="500"
                      pattern="https?://.*"
                      placeholder="https://…"
                      title="Must start with http:// or https://"
                    />
                  </div>
                  <div>
                    <label class="ugc-label" for="free-image">Image — optional</label>
                    <input
                      class="ugc-file"
                      id="free-image"
                      type="file"
                      name="image"
                      accept="image/jpeg,image/png,image/webp"
                    />
                    <span class="ugc-hint">JPG, PNG, or WebP — up to {Math.floor(IMAGE_MAX_BYTES / (1024 * 1024))}MB.</span>
                  </div>
                  <button class="ugc-submit ghost" type="submit">Pin it</button>
                </form>
              </details>
            </div>
          )
        }
        {editable && gridFull && <p class="p-hint mono">Rotation full — unpin something to make room.</p>}
      </section>

      <section id="wall">
        <div class="section-label p-label">
          <span class="eyebrow">{displayName}’s wall</span>
          <span class="line"></span>
          <span class="eyebrow">{wall.length}</span>
        </div>

        {wallResult && !wallResult.ok && <p class="p-wall-msg mono">{wallResult.message}</p>}

        {
          wallOpen &&
            (viewerId ? (
              <form class="p-wall-form" method="POST" data-astro-reload>
                <input type="hidden" name="action" value="wall-post" />
                <textarea
                  class="ugc-textarea"
                  name="body"
                  rows="3"
                  required
                  maxlength="1000"
                  placeholder={`Write something for ${displayName}…`}></textarea>
                <button class="ugc-submit ghost" type="submit">Leave a note</button>
              </form>
            ) : (
              <p class="p-empty">
                <a href="/login">Sign in</a> to write on the wall.
              </p>
            ))
        }
        {
          editable && !wallOpen && (
            <p class="p-hint mono">
              Your wall opens for notes once your profile is public — flip it in <a href="/settings">Settings</a>.
            </p>
          )
        }

        {
          wall.length === 0 ? (
            <p class="p-empty">No notes yet{wallOpen && viewerId ? ' — leave the first one.' : '.'}</p>
          ) : (
            <ul class="p-wall">
              {wall.map((note) => (
                <li>
                  <div class="p-wall-head">
                    {note.author_href ? (
                      <a class="p-wall-a" href={note.author_href}>{note.author_name}</a>
                    ) : (
                      <span class="p-wall-a">{note.author_name}</span>
                    )}
                    <span class="p-wall-d mono">{ugcDate(note.created_at)}</span>
                    {canRemove(note) && (
                      <form method="POST" data-astro-reload>
                        <input type="hidden" name="action" value="wall-delete" />
                        <input type="hidden" name="id" value={note.id} />
                        <button class="p-wall-x mono" type="submit" aria-label={`Remove ${note.author_name}'s note`}>
                          ×
                        </button>
                      </form>
                    )}
                  </div>
                  <p class="p-wall-b">{note.body}</p>
                  {viewerId && !canRemove(note) && (
                    <details class="p-wall-report">
                      <summary class="mono">Report this</summary>
                      <form method="POST" data-astro-reload>
                        <input type="hidden" name="action" value="wall-report" />
                        <input type="hidden" name="id" value={note.id} />
                        <textarea
                          class="ugc-textarea"
                          name="reason"
                          rows="2"
                          required
                          maxlength="1000"
                          placeholder="What's wrong with it?"></textarea>
                        <button class="ugc-submit ghost" type="submit">Send report</button>
                      </form>
                    </details>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <slot name="manage" />
    </div>
  </div>
</section>

<script>
  // Catalog "combobox": type-to-filter over the server-rendered catalog rows,
  // first 10 matches shown, ArrowDown hops from the input into the list.
  // Document-level delegation so it survives ClientRouter page swaps with no
  // per-page init; CSS (@media scripting) reveals the input only when JS runs.
  const CAP = 10;
  let countTimer: ReturnType<typeof setTimeout>;

  function applyFilter(input: HTMLInputElement): void {
    const box = input.closest('.p-add-box');
    if (!box) return;
    const q = input.value.trim().toLowerCase();
    let matches = 0;
    for (const li of box.querySelectorAll<HTMLLIElement>('.p-add-panel > li')) {
      const hit = !q || (li.dataset.name ?? '').includes(q);
      if (hit) matches++;
      li.hidden = !hit || matches > CAP;
    }
    const count = box.querySelector('.p-add-count');
    if (!count) return;
    // Debounced so the live region doesn't talk over every keystroke.
    clearTimeout(countTimer);
    countTimer = setTimeout(() => {
      count.textContent = !q
        ? ''
        : matches === 0
          ? 'No matches'
          : matches > CAP
            ? `First ${CAP} of ${matches} matches`
            : `${matches} ${matches === 1 ? 'match' : 'matches'}`;
    }, 300);
  }

  document.addEventListener('input', (e) => {
    const t = e.target;
    if (t instanceof HTMLInputElement && t.id === 'catalog-filter') applyFilter(t);
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target;
    if (e.key !== 'ArrowDown' || !(t instanceof HTMLInputElement) || t.id !== 'catalog-filter') return;
    const first = t
      .closest('.p-add-box')
      ?.querySelector<HTMLButtonElement>('.p-add-panel li:not([hidden]) button');
    if (first) {
      e.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  .profile {
    max-width: 1120px;
    margin: 0 auto;
    padding: 40px 48px 220px;
  }
  .p-banner {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 10px 16px;
    margin-bottom: 28px;
  }
  .p-cols {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 44px;
    align-items: start;
  }

  /* ---- Left column: module boxes ---- */
  .p-side {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .p-box {
    border: 1px solid var(--hairline);
    background: var(--surface-1);
  }
  .p-box-h {
    display: block;
    padding: 10px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--hairline);
    font-weight: 400;
  }

  /* profile card */
  .p-avatar {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-bottom: 1px solid var(--hairline);
    filter: grayscale(0.25) contrast(1.04);
    background: var(--recess);
  }
  .p-avatar-fallback {
    display: grid;
    place-items: center;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 110px;
    color: var(--ink-3);
    box-shadow: inset 0 2px 30px color-mix(in srgb, var(--shadow) 70%, transparent);
  }
  .p-card-body {
    padding: 18px 16px 20px;
  }
  .p-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 24px;
    line-height: 1.2;
    color: var(--ink);
  }
  .p-kind {
    display: inline-block;
    margin-top: 6px;
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .p-status {
    margin-top: 12px;
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .p-meta {
    list-style: none;
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .p-meta li {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .p-song {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-top: 16px;
    padding: 10px 12px;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .p-song:hover {
    border-color: var(--ember);
  }
  .p-song svg {
    flex: none;
    width: 26px;
    height: 26px;
    padding: 6px;
    border-radius: 999px;
    background: var(--ember);
    color: var(--on-ember);
  }
  .p-song-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .p-song-meta i {
    font-style: normal;
    font-size: 8px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .p-song-meta b {
    font-weight: 400;
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p-card-acts {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .p-card-acts a {
    flex: 1;
    text-align: center;
    text-decoration: none;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 9px 8px;
    color: var(--ink-2);
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 9px;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .p-card-acts a:hover {
    border-color: var(--ember);
    color: var(--ember);
  }
  .p-card-acts form {
    flex: 1;
    display: flex;
  }
  .p-pin {
    flex: 1;
    background: none;
    text-align: center;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 9px 8px;
    color: var(--ink-2);
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 9px;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  button.p-pin:hover {
    border-color: var(--ember);
    color: var(--ember);
  }
  .p-pin-done {
    cursor: default;
    color: var(--ink-3);
  }
  .p-card-msg {
    margin-top: 10px;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-deep);
  }

  /* account box */
  .p-admin {
    display: flex;
    flex-direction: column;
  }
  .p-admin a,
  .p-admin button {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    border-bottom: 1px solid var(--hairline-soft);
    padding: 11px 14px;
    color: var(--ink-2);
    text-decoration: none;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 10px;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .p-admin > :last-child,
  .p-admin > :last-child button {
    border-bottom: none;
  }
  .p-admin a:hover,
  .p-admin button:hover {
    color: var(--ember);
  }

  /* site news */
  .p-news {
    list-style: none;
  }
  .p-news a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--hairline-soft);
    text-decoration: none;
  }
  .p-news li:last-child a {
    border-bottom: none;
  }
  .p-news-k {
    font-size: 8px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .p-news-t {
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .p-news a:hover .p-news-t {
    color: var(--ember);
  }

  /* ---- Main column ---- */
  .p-main {
    display: flex;
    flex-direction: column;
    gap: 38px;
    min-width: 0;
  }
  .p-label {
    padding: 0;
    margin: 0 0 16px;
  }
  .p-bio {
    font-size: 16px;
