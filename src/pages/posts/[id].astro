---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import ReportForm from '../../components/ReportForm.astro';
import VisibilityToggle from '../../components/VisibilityToggle.astro';
import { handleReport, setVisibility } from '../../lib/report';
import { displayNames, publicProfileIds, renderMarkdown, ugcDate } from '../../lib/ugc';

const id = Astro.params.id!;
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;

// One formData read, dispatched on `action`: the owner's visibility toggle
// (PRG on success) or a report.
let reportResult: { ok: boolean; message: string } | null = null;
let visError: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'set-visibility') {
    visError = await setVisibility(Astro.locals, 'posts', id, form);
    if (!visError) return Astro.redirect(`/posts/${id}`, 303);
  } else {
    reportResult = await handleReport(form, Astro.locals, 'post', id);
  }
}

const { data: post } = await supabase
  .from('posts')
  .select('id, user_id, title, body_md, status, created_at')
  .eq('id', id)
  .maybeSingle();
if (!post) return Astro.redirect('/community');

const names = await displayNames(supabase, [post.user_id]);
const author = names.get(post.user_id) ?? 'a listener';
const authorHref = (await publicProfileIds(supabase, [post.user_id])).has(post.user_id)
  ? `/u/${post.user_id}`
  : null;
const own = user?.id === post.user_id;
const html = renderMarkdown(post.body_md ?? '');
---

<Base title={post.title} section="community">
  <article class="post">
    <header>
      <span class="eyebrow">
        Listener writing · {ugcDate(post.created_at)}
        {
          post.status !== 'published' && (
            <span class="badge">
              {post.status === 'removed' ? 'removed by the curator' : post.status} — only you can see this
            </span>
          )
        }
      </span>
      <h1>{post.title}</h1>
      <p class="byline">by {authorHref ? <a href={authorHref}>{author}</a> : author}</p>
      {own && <VisibilityToggle status={post.status} error={visError} />}
    </header>

    <div class="prose" set:html={html} />

    {!own && <ReportForm signedIn={Boolean(user)} result={reportResult} />}
  </article>
</Base>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 80px 48px 220px;
  }
  .badge {
    margin-left: 12px;
    color: var(--ember);
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.18;
    color: var(--ink);
    margin: 18px 0 10px;
  }
  .byline {
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 0.6875rem;
    color: var(--ember);
    margin-bottom: 44px;
  }
  .byline a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Rendered markdown (set:html) needs :global selectors. */
  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
    margin-bottom: 22px;
  }
  .prose :global(h2),
  .prose :global(h3) {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink);
    margin: 38px 0 16px;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
  }
  .prose :global(h3) {
    font-size: 1.1875rem;
  }
  .prose :global(ul) {
    margin: 0 0 22px 20px;
    color: var(--ink);
  }
  .prose :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 8px;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--ember);
    padding-left: 20px;
    margin: 0 0 22px;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--stone);
  }
  .prose :global(a) {
    color: var(--ember);
    text-underline-offset: 4px;
  }
</style>
