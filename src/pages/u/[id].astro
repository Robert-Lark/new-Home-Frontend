---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import ProfilePage from '../../components/ProfilePage.astro';
import { getEpisodes } from '../../lib/content';
import {
  buildActivity,
  getConnections,
  getProfileDetails,
  getProfileRow,
  getSiteNews,
  getUserContent,
  resolveTrack,
} from '../../lib/profile';
import {
  getWallComments,
  handleWallAction,
  resolveWallEntries,
  type WallActionResult,
} from '../../lib/wall';

/**
 * Public profile view — what anyone (signed in or not) sees of a listener who
 * has made their page public. Owners land here too, as a "preview as visitor".
 * RLS already hides private rows (favorites, listens, non-public details);
 * the publishedOnly content filter keeps the owner's own drafts out of the
 * preview as well.
 */
const id = Astro.params.id!;
const supabase = Astro.locals.supabase;
const viewer = Astro.locals.user;
const own = viewer?.id === id;

// Wall posts/deletes/reports are the page's only forms. Successes redirect
// (PRG, like the dashboard grid); failures render inline (like report.ts).
let wallResult: WallActionResult | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  wallResult = await handleWallAction(form, viewer, supabase, id);
  if (wallResult?.ok) return Astro.redirect(`/u/${id}#wall`);
}

const profile = await getProfileRow(supabase, id);
const details = profile ? await getProfileDetails(supabase, id) : null;
const visible = Boolean(profile && (details?.is_public || own));

if (!visible) Astro.response.status = 404;

const episodes = visible ? await getEpisodes() : [];
const epByRef = new Map(episodes.map((e) => [e.slug, e]));

const [connections, content, news, wallComments] = visible
  ? await Promise.all([
      getConnections(supabase, id),
      getUserContent(supabase, id, true),
      getSiteNews(supabase, episodes),
      getWallComments(supabase, id),
    ])
  : [[], { mixes: [], posts: [], lists: [], albums: [] }, [], []];

const wall = await resolveWallEntries(supabase, wallComments);
const activity = buildActivity({ content, episodesByRef: epByRef, connections, wallNotes: wall });

const song = details?.profile_song_ref
  ? await resolveTrack(supabase, details.profile_song_ref, epByRef)
  : null;

const displayName = profile?.display_name || 'A listener';
const memberSince = profile?.created_at
  ? new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(new Date(profile.created_at))
  : null;
---

<Base
  title={visible ? displayName : 'Private signal'}
  description={visible ? `${displayName} on Quiet Cast.` : undefined}
  section="community"
>
  {
    visible ? (
      <ProfilePage
        editable={false}
        profileId={id}
        displayName={displayName}
        avatarUrl={profile?.avatar_url ?? null}
        memberSince={memberSince}
        statusLine={details?.status_line}
        bio={details?.bio}
        isPublic={details?.is_public ?? false}
        song={song}
        connections={connections}
        activity={activity}
        news={news}
        wall={wall}
        wallOpen={details?.is_public ?? false}
        viewerId={viewer?.id ?? null}
        wallResult={wallResult}
        previewBanner={
          own
            ? details?.is_public
              ? 'Preview — this is how visitors see your page.'
              : 'Preview — your page is private, so only you can see this. Make it public in Settings.'
            : undefined
        }
      />
    ) : (
      <section class="private">
        <span class="eyebrow">No signal</span>
        <h1>This page is private</h1>
        <p>Either this listener keeps their profile to themselves, or there's nothing broadcasting here.</p>
        <a href="/community">Back to the community</a>
      </section>
    )
  }
</Base>

<style>
  .private {
    max-width: 560px;
    margin: 0 auto;
    padding: 140px 48px 220px;
    text-align: center;
  }
  .private h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(26px, 4vw, 38px);
    color: var(--ink);
    margin: 16px 0 14px;
  }
  .private p {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 30px;
  }
  .private a {
    display: inline-block;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 11px 18px;
    color: var(--ink-2);
    text-decoration: none;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 10px;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .private a:hover {
    border-color: var(--ember);
    color: var(--ember);
  }
</style>
