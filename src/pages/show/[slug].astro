---
import Base from '../../layouts/Base.astro';
import { getEpisodes, trackOf, sizedCover } from '../../lib/content';
import LibraryControls from '../../islands/LibraryControls';

// Static generation: one page per episode, queried from Sanity at build time.
export async function getStaticPaths() {
  const episodes = await getEpisodes();
  const queueJson = JSON.stringify(episodes.map(trackOf));
  return episodes.map((episode) => ({ params: { slug: episode.slug }, props: { episode, queueJson } }));
}

const { episode, queueJson } = Astro.props;
const t = trackOf(episode);
---

<Base title={episode.title} description={episode.description} section="listen">
  <article class="show">
    <div class="show-cover">
      <div class="recess"><img src={sizedCover(episode.coverUrl, 900)} alt={`${episode.title} cover`} /></div>
    </div>

    <div class="show-meta">
      <span class="eyebrow">{episode.catLabel}{episode.year ? ` · ${episode.year}` : ''}</span>
      <h1>{episode.title}</h1>
      <p class="by">{episode.artist}</p>

      <div class="show-actions">
        <button
          class="play-lg"
          data-qc-play
          data-qc-id={t.id}
          data-qc-title={t.title}
          data-qc-artist={t.artist}
          data-qc-cover={t.cover}
          data-qc-src={t.src}
          data-qc-catalog={t.catalog}
          data-qc-queue={queueJson}
        >
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          <span>Play broadcast</span>
        </button>
        <button class="act-btn fav-btn" data-qc-fav-btn data-qc-ref={episode.slug}>
          <svg viewBox="0 0 24 24"><path d="M12 21C12 21 4 13.8 4 8.5 4 5.4 6.4 3 9.5 3 11 3 12 4.2 12 4.2S13 3 14.5 3C17.6 3 20 5.4 20 8.5 20 13.8 12 21 12 21z" /></svg>
          <span>Favorite</span>
        </button>
        <button class="act-btn" data-qc-playlist-btn data-qc-ref={episode.slug}>
          <svg viewBox="0 0 24 24"><path d="M4 7h11M4 12h7M4 17h7M16 13v8M12 17h8" /></svg>
          <span>Add to playlist</span>
        </button>
      </div>

      {episode.description && <p class="desc">{episode.description}</p>}

      {
        episode.tracklist.length > 0 && (
          <>
            <div class="section-label" style="padding:0;margin:34px 0 18px">
              <span class="eyebrow">Tracklist</span>
              <span class="line" />
            </div>
            <ol class="tracklist">
              {episode.tracklist.map((track, i) => (
                <li>
                  <span class="tl-n mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="tl-t">{track}</span>
                </li>
              ))}
            </ol>
          </>
        )
      }
    </div>
  </article>

  {
    episode.qa.length > 0 && (
      <section class="interview">
        <div class="section-label">
          <span class="eyebrow">In conversation</span>
          <span class="line" />
          <span class="eyebrow">with {episode.artist}</span>
        </div>
        <div class="qa">
          {episode.qa.map((pair) => (
            <div class="qa-pair">
              <p class="qa-q">{pair.q}</p>
              <p class="qa-a">{pair.a}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {/* Inline favorite toggle + add-to-playlist popover (delegated clicks). */}
  <LibraryControls client:idle />
</Base>

<style>
  .show {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    max-width: 1040px;
    margin: 0 auto;
    padding: 60px 48px 40px;
    align-items: start;
  }
  .recess {
    padding: 16px;
    background: var(--recess);
    border: 1px solid var(--hairline);
    box-shadow:
      inset 0 2px 30px color-mix(in srgb, var(--shadow) 90%, transparent),
      0 40px 100px -30px color-mix(in srgb, var(--shadow) 90%, transparent);
  }
  .recess img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05);
  }
  .show-meta h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.15;
    color: var(--ink);
    margin: 18px 0 10px;
  }
  .by {
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 0.6875rem;
    color: var(--ember);
  }
  .show-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin: 34px 0 28px;
  }
  .play-lg {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 13px 26px 13px 20px;
    border: none;
    border-radius: 999px;
    background: var(--ember);
    color: var(--on-ember);
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.6875rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .play-lg:hover {
    transform: translateY(-1px);
  }
  .play-lg svg {
    width: 16px;
    height: 16px;
  }
  .act-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 20px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.625rem;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .act-btn:hover {
    border-color: var(--ember);
    color: var(--ember);
  }
  .act-btn svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fav-btn[data-qc-fav='on'] {
    border-color: var(--ember);
    color: var(--ember);
  }
  .fav-btn[data-qc-fav='on'] svg {
    fill: var(--ember);
    stroke: var(--ember);
  }
  .desc {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 56ch;
  }
  .tracklist {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .tracklist li {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }
  .tl-n {
    font-size: 0.625rem;
    color: var(--ink-3);
    letter-spacing: 0.1em;
  }
  .tl-t {
    font-size: 1rem;
    color: var(--ink);
  }

  /* Interview reading view — bone "document" feel via wider measure + serif */
  .interview {
    max-width: 760px;
    margin: 0 auto;
    padding: 20px 48px 200px;
  }
  .qa-pair {
    margin-bottom: 34px;
  }
  .qa-q {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--stone);
    margin-bottom: 12px;
  }
  .qa-a {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
    white-space: pre-wrap;
  }

  @media (max-width: 760px) {
    .show {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 30px;
    }
    .show-cover {
      max-width: 340px;
    }
  }
</style>
