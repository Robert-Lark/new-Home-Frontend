---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import PhotoUploadForm from '../../islands/PhotoUploadForm';

if (!Astro.locals.user) return Astro.redirect('/login');
---

<Base title="Concert photos" section="community">
  <section class="page">
    <span class="eyebrow"><a href="/contribute">Contribute</a> · Photos</span>
    <h1>Concert photos</h1>
    <p class="intro">
      An album of pictures from a show you attended — only upload photos you took yourself. Post
      it public or keep it private; flip it any time from the album's page.
    </p>
    <PhotoUploadForm client:load />
  </section>
</Base>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 80px 48px 220px;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    color: var(--ember);
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--ink);
    margin: 14px 0 12px;
  }
  .intro {
    color: var(--ink-2);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 38px;
  }
</style>
