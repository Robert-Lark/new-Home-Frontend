---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { MAX_CREATED_PER_DAY } from '../../lib/ugc';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const supabase = Astro.locals.supabase;

// HTML-first: a plain form POSTing back to this page — no island, no client JS.
let errorMsg: string | null = null;
let title = '';
let body = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  title = String(form.get('title') ?? '').trim();
  body = String(form.get('body') ?? '').trim();
  // Visibility is the author's call — private means only they see it.
  const status = form.get('visibility') === 'private' ? 'private' : 'published';

  if (!title || !body) {
    errorMsg = 'A title and some writing are both required.';
  } else if (title.length > 160) {
    errorMsg = 'Keep the title under 160 characters.';
  } else if (body.length > 20000) {
    errorMsg = 'Posts max out at 20,000 characters.';
  } else {
    // Abuse brake: 24h creation cap. Explicit user filter — the select
    // policy is own-or-published, so an unfiltered count sees everyone.
    const { count } = await supabase
      .from('posts')
      .select('id', { count: 'exact', head: true })
      .eq('user_id', user.id)
      .gte('created_at', new Date(Date.now() - 24 * 3600 * 1000).toISOString());
    if ((count ?? 0) >= MAX_CREATED_PER_DAY) {
      errorMsg = 'Daily cap reached — twenty new pieces in 24 hours. Come back tomorrow.';
    } else {
      const slugBase =
        title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 80) || 'post';
      let { data, error } = await supabase
        .from('posts')
        .insert({ user_id: user.id, slug: slugBase, title, body_md: body, status })
        .select('id')
        .single();
      if (error?.code === '23505') {
        // slug taken by an earlier post of theirs — suffix and retry once
        ({ data, error } = await supabase
          .from('posts')
          .insert({
            user_id: user.id,
            slug: `${slugBase}-${crypto.randomUUID().slice(0, 8)}`,
            title,
            body_md: body,
            status,
          })
          .select('id')
          .single());
      }
      if (error || !data) {
        errorMsg = `Couldn't save the post: ${error?.message ?? 'unknown error'}.`;
      } else {
        return Astro.redirect(`/posts/${data.id}`, 303);
      }
    }
  }
}
---

<Base title="Write a post" section="community">
  <section class="page">
    <span class="eyebrow"><a href="/contribute">Contribute</a> · Post</span>
    <h1>Write a post</h1>
    <p class="intro">
      A review, a show report, a piece on a record. Public posts land in the community section the
      moment you post them; private ones stay yours until you flip them — from the post's page,
      any time.
    </p>

    <form class="ugc-form" method="POST" data-astro-reload>
      <label class="ugc-label" for="post-title">Title</label>
      <input
        id="post-title"
        class="ugc-input"
        type="text"
        name="title"
        required
        maxlength="160"
        placeholder="On the last Bohren record"
        value={title}
      />

      <label class="ugc-label" for="post-body">Body</label>
      <textarea id="post-body" class="ugc-textarea" name="body" required rows="16" maxlength="20000"
        >{body}</textarea
      >
      <p class="ugc-hint mono">
        Formatting: # heading · **bold** · *italic* · [link](https://…) · "- " lists · "&gt;" quotes
      </p>

      <fieldset class="ugc-vis">
        <legend class="ugc-label">Visibility</legend>
        <label>
          <input type="radio" name="visibility" value="published" checked />
          <span><b>Public</b> — on the community shelf and your profile.</span>
        </label>
        <label>
          <input type="radio" name="visibility" value="private" />
          <span><b>Private</b> — only you can see it. Flip it later from the post's page.</span>
        </label>
      </fieldset>

      <button class="ugc-submit" type="submit">Post it</button>
      {errorMsg && <p class="ugc-error">{errorMsg}</p>}
    </form>
  </section>
</Base>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 80px 48px 220px;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    color: var(--ember);
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--ink);
    margin: 14px 0 12px;
  }
  .intro {
    color: var(--ink-2);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 38px;
  }
</style>
