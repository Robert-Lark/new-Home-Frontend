---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import MixUploadForm from '../../islands/MixUploadForm';

if (!Astro.locals.user) return Astro.redirect('/login');
---

<Base title="Upload a mix" section="community">
  <section class="page">
    <span class="eyebrow"><a href="/contribute">Contribute</a> · Mix</span>
    <h1>Upload a mix</h1>
    <p class="intro">
      Your tape streams from the same zero-egress archive as the broadcasts. Post it public or
      keep it private — your call, changeable any time from the mix's page.
    </p>
    <MixUploadForm client:load />
  </section>
</Base>

<style>
  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 80px 48px 220px;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    color: var(--ember);
  }
  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(28px, 4vw, 44px);
    color: var(--ink);
    margin: 14px 0 12px;
  }
  .intro {
    color: var(--ink-2);
    font-style: italic;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 38px;
  }
</style>
