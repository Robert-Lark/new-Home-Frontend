---
import Base from '../layouts/Base.astro';
import ListenState from '../islands/ListenState';

// Hsieh date-grid ledger. Generated at build time (no client JS) with a
// deterministic seeded PRNG so output is stable across builds. Phase 3 swaps
// this for real show dates from Sanity (each marked day links to its show).
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const YEARS = [2026, 2025, 2024, 2023];

let seed = 7;
const rnd = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};

const years = YEARS.map((yr, yi) => {
  let count = 0;
  const months = MONTHS.map((label, mi) => {
    const days = mi % 2 ? 30 : 31;
    const cells = Array.from({ length: days }, (_, idx) => {
      const day = idx + 1;
      const has = rnd() < 0.34;
      const live = yi === 0 && mi === 10 && day === 29;
      if (has || live) count++;
      return { day, has, live };
    });
    return { label, cells };
  });
  return { yr, count, months };
});

const totalShows = years.reduce((n, y) => n + y.count, 0);
---

<Base title="The Archive" section="archive">
  <div class="head">
    <h1>The Archive</h1>
    <div class="meta mono">
      {totalShows} transmissions<br />2021 — 2026<br />614 hours of signal
    </div>
  </div>

  <div class="legend">
    <span><i style="border:1px solid var(--stone)"></i>recorded show</span>
    <span><i style="background:var(--ember)"></i>now playing</span>
    <span><i style="background:var(--surface-1)"></i>silence</span>
  </div>

  <div class="years">
    {
      years.map((y) => (
        <div class="year">
          <div class="ynum">
            {y.yr}
            <span class="c mono">{y.count} shows</span>
          </div>
          <div class="months">
            {y.months.map((m) => (
              <div class="mo">
                <div class="ml">{m.label}</div>
                {/* Phase 3: each real show cell gets data-qc-ref={show.slug} +
                    an <a> to its page; the ListenState island below then paints
                    data-qc-state on it. These placeholder cells carry no ref, so
                    they stay neutral for everyone. */}
                <div class="dots">
                  {m.cells.map((c) => (
                    <span class={c.live ? 'live' : c.has ? 'has' : ''}>{c.has || c.live ? c.day : ''}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {/* Recolors any [data-qc-ref] cell by the signed-in user's listen state.
      Neutral for logged-out visitors and until Phase 3 wires real show cells. */}
  <ListenState client:idle />
</Base>

<style>
  .head {
    padding: 50px 56px 10px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .head h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: clamp(30px, 5vw, 46px);
    padding-left: 0.3em;
  }
  .head .meta {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    text-align: right;
    line-height: 1.8;
    text-transform: uppercase;
  }
  .legend {
    display: flex;
    gap: 26px;
    padding: 14px 56px 30px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .legend i {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin-right: 7px;
    vertical-align: middle;
  }
  .years {
    padding: 0 56px 200px;
    display: flex;
    flex-direction: column;
    gap: 46px;
  }
  .year {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 34px;
    align-items: start;
  }
  .ynum {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 80px;
    line-height: 0.8;
    -webkit-text-stroke: 1px var(--ink-3);
    color: transparent;
  }
  .ynum .c {
    display: block;
    -webkit-text-stroke: 0;
    color: var(--ink-3);
    font-size: 10px;
    letter-spacing: 0.2em;
    margin-top: 14px;
  }
  .months {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px 30px;
  }
  .ml {
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 9px;
    color: var(--ink-2);
    margin-bottom: 9px;
    border-bottom: 1px solid var(--hairline-soft);
    padding-bottom: 6px;
  }
  .dots {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 5px;
  }
  .dots span {
    aspect-ratio: 1;
    border-radius: 50%;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    display: grid;
    place-items: center;
    color: transparent;
    background: var(--surface-1);
  }
  .dots span.has {
    background: transparent;
    border: 1px solid var(--stone);
    color: var(--ink-2);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .dots span.has:hover {
    border-color: var(--ink);
    color: var(--ink);
    transform: scale(1.15);
  }
  .dots span.live {
    background: var(--ember);
    border-color: var(--ember);
    color: #0d0e10;
  }
  /* Per-user listen state (painted by the ListenState island once cells carry
     data-qc-ref in Phase 3): in-progress rings ember, done fills faint ember. */
  .dots span[data-qc-state='in-progress'] {
    border: 1px solid var(--ember);
    color: var(--ember);
  }
  .dots span[data-qc-state='done'] {
    background: color-mix(in srgb, var(--ember) 22%, transparent);
    border: 1px solid var(--ember);
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .months {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
