---
import Base from '../layouts/Base.astro';
import { getEpisodes, trackOf } from '../lib/content';
import PlaylistManager from '../islands/PlaylistManager';

// Static page: the user's library data is fetched client-side (RLS anon client,
// cookie session) by the island — same neutral-when-logged-out pattern as the
// home grid, so this route stays off the SSR auth path. We only render a track
// index here so the island can resolve content_refs → playable Tracks.
const episodes = await getEpisodes();
// `<` keeps the JSON valid while ensuring a CMS title can never emit a
// literal `</script>` that would close this inline tag early.
const trackIndex = JSON.stringify(episodes.map(trackOf)).replace(/</g, '\\u003c');
---

<Base title="Library" section="playlists">
  <section class="pl-page">
    <header class="pl-head">
      <span class="eyebrow">Broadcasting from · local time</span>
      <h1>Library</h1>
      <p class="pl-sub">Favorites and named playlists. Press play — it plays through.</p>
    </header>

    {/* Resolves playlist/favorite content_refs to playable Tracks (all episodes). */}
    <script id="qc-track-index" type="application/json" is:inline set:html={trackIndex}></script>

    <PlaylistManager client:only="preact" />
  </section>
</Base>

<style>
  .pl-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 50px 48px 220px;
  }
  .pl-head {
    padding-bottom: 30px;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 40px;
  }
  .pl-head h1 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--ink);
    margin: 14px 0 10px;
  }
  .pl-sub {
    color: var(--ink-2);
    font-style: italic;
    font-size: 1rem;
  }
</style>

<style is:global>
  /* PlaylistManager island DOM (Preact → not scopable; lives global). */
  .lib {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .lib-note {
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.6;
  }
  .lib-link {
    color: var(--ember);
    text-underline-offset: 4px;
  }
  .lib-empty {
    color: var(--ink-3);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    list-style: none;
    padding: 8px 0;
  }
  .lib-play-all {
    margin-bottom: 14px;
    background: none;
    border: 1px solid var(--hairline);
    color: var(--ink);
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.625rem;
    padding: 9px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .lib-play-all:hover:not(:disabled) {
    border-color: var(--ember);
    color: var(--ember);
  }
  .lib-play-all:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .lib-items {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .lib-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }
  .lib-item-play {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: none;
    color: var(--ember);
    cursor: pointer;
    font-size: 0.6875rem;
    line-height: 1;
    display: grid;
    place-items: center;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .lib-item-play:hover {
    border-color: var(--ember);
    background: color-mix(in srgb, var(--ember) 14%, transparent);
  }
  .lib-item-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .lib-item-t {
    color: var(--ink);
    font-size: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lib-item-a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .lib-item-x {
    flex: none;
    background: none;
    border: none;
    color: var(--ink-3);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 6px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .lib-item-x:hover {
    color: var(--ember-deep);
  }
  .lib-reorder {
    display: flex;
    flex-direction: column;
    flex: none;
  }
  .lib-reorder button {
    background: none;
    border: none;
    color: var(--ink-3);
    cursor: pointer;
    font-size: 0.5rem;
    line-height: 1;
    padding: 1px 4px;
  }
  .lib-reorder button:hover:not(:disabled) {
    color: var(--ink);
  }
  .lib-reorder button:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .lib-create {
    display: flex;
    gap: 10px;
    margin-bottom: 22px;
  }
  .lib-create-input,
  .lib-rename-input,
  .ql-menu-input {
    flex: 1;
    background: var(--surface-1);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 10px 14px;
    color: var(--ink);
    font-family: 'Spectral', serif;
    font-size: 1rem;
  }
  .lib-create-input:focus,
  .lib-rename-input:focus,
  .ql-menu-input:focus {
    outline: none;
    border-color: var(--ember);
  }
  .lib-create-btn {
    flex: none;
    background: var(--ember);
    color: var(--on-ember);
    border: none;
    border-radius: 999px;
    padding: 10px 18px;
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.625rem;
    cursor: pointer;
  }
  .lib-create-btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .lib-pls {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lib-pl {
    border-bottom: 1px solid var(--hairline-soft);
    padding: 6px 0;
  }
  .lib-pl-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .lib-pl-name {
    display: flex;
    align-items: center;
    gap: 12px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--ink);
    font-family: 'Cormorant Garamond', serif;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 1.125rem;
    padding: 6px 0;
  }
  .lib-pl-caret {
    color: var(--ink-3);
    font-size: 0.6875rem;
  }
  .lib-pl-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .lib-pl-actions {
    display: flex;
    gap: 6px;
  }
  .lib-mini {
    background: none;
    border: 1px solid var(--hairline);
    color: var(--ink-2);
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.625rem;
    padding: 6px 10px;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .lib-mini:hover:not(:disabled) {
    border-color: var(--ember);
    color: var(--ember);
  }
  .lib-mini.danger:hover {
    border-color: var(--ember-deep);
    color: var(--ember-deep);
  }
  .lib-mini:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .lib-rename {
    display: flex;
    gap: 8px;
    align-items: center;
    flex: 1;
  }
  .lib-items.nested {
    margin: 8px 0 6px 8px;
    padding-left: 14px;
    border-left: 1px solid var(--hairline-soft);
  }

  /* LibraryControls add-to-playlist popover (mounted on home/show/playlists). */
  .ql-menu {
    position: fixed;
    z-index: 120;
    background: var(--glass-strong);
    backdrop-filter: blur(18px) saturate(120%);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    box-shadow: 0 24px 60px -20px color-mix(in srgb, var(--shadow) 85%, transparent);
    padding: 12px;
  }
  .ql-menu-h {
    font-family: 'IBM Plex Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.625rem;
    color: var(--ink-3);
    padding: 2px 4px 10px;
  }
  .ql-menu-list {
    display: flex;
    flex-direction: column;
    max-height: 240px;
    overflow-y: auto;
  }
  .ql-menu-row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 6px;
    border-radius: 6px;
    text-align: left;
    color: var(--ink);
  }
  .ql-menu-row:hover {
    background: var(--surface-2);
  }
  .ql-check {
    flex: none;
    width: 16px;
    height: 16px;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    display: grid;
    place-items: center;
    font-size: 0.625rem;
    color: var(--on-ember);
  }
  .ql-check.on {
    background: var(--ember);
    border-color: var(--ember);
  }
  .ql-menu-name {
    flex: 1;
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ql-menu-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: var(--ink-3);
  }
  .ql-menu-empty {
    color: var(--ink-3);
    font-style: italic;
    font-size: 0.875rem;
    padding: 6px;
  }
  .ql-menu-new {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--hairline-soft);
  }
  .ql-menu-new .ql-menu-input {
    font-size: 1rem;
    padding: 8px 10px;
  }
  .ql-menu-add {
    flex: none;
    width: 34px;
    background: var(--ember);
    color: var(--on-ember);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
  }
  .ql-menu-add:disabled {
    opacity: 0.45;
    cursor: default;
  }
</style>
